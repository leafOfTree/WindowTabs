<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <BenchmarkAppDir>../Debug/</BenchmarkAppDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.fs" />
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <Reference Include="WindowTabs" HintPath="$(BenchmarkAppDir)/WindowTabs.exe" />
    <Reference Include="Win32" HintPath="$(BenchmarkAppDir)/Win32.dll" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
