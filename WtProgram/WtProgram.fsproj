<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>WindowTabs</AssemblyName>
    <RootNamespace>WindowTabs</RootNamespace>
    <!-- F# projects do not pick up App.config on their own; it carries the DPI awareness settings. -->
    <AppConfig>App.config</AppConfig>
    <ApplicationIcon>Resources\Bemo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The release workflow overrides this from the tag: dotnet build -c Release -p:Version=2025.10.01 -->
    <Version>2025.06.30</Version>
    <!-- Shown to users (tray, settings, crash log), so no "+commit" suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyTitle>WindowTabs</AssemblyTitle>
    <Product>WindowTabs</Product>
    <Description>Brings browser-style tabbed window management to the desktop</Description>
    <Company>WindowTabs contributors</Company>
    <Copyright>Licensed under the terms in LICENSE</Copyright>
    <!-- Keep bin\<Configuration>\ so scripts and CI find WindowTabs.exe where they always have. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- FSharp.Core ships translated messages for many cultures; the app only needs the neutral ones. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <WarningLevel>3</WarningLevel>
    <NoWarn>$(NoWarn);0040;0046;0058;0760;1183;2009</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Tailcalls>false</Tailcalls>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Tailcalls>true</Tailcalls>
    <!-- Release is a single self-contained WindowTabs.exe. -->
    <OtherFlags>$(OtherFlags) --standalone --staticlink:Win32 --staticlink:Newtonsoft.Json --staticlink:Aga.Controls --staticlink:Interop.SHDocVw --staticlink:Interop.Shell32</OtherFlags>
    <!-- FS2011: framework internals (SMDiagnostics, System.ServiceModel.Internals) reached through
         System.Runtime.Serialization are not in the reference assemblies; they stay in the GAC, not the exe. -->
    <NoWarn>$(NoWarn);2011</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="AssemblyInfo.fs" />
    <Compile Include="Shared\Operators.fs" />
    <Compile Include="Shared\Dynamic.fs" />
    <Compile Include="Shared\Observable.fs" />
    <Compile Include="Shared\Blackboard.fs" />
    <Compile Include="Shared\Invoker.fs" />
    <Compile Include="Shared\Lifetime.fs" />
    <Compile Include="Shared\BackgroundWork.fs" />
    <Compile Include="Shared\Cell.fs" />
    <Compile Include="Shared\Drawing.fs" />
    <Compile Include="Shared\Sprite.fs" />
    <Compile Include="Shared\TabStripTypes.fs" />
    <Compile Include="Shared\Dpi.fs" />
    <Compile Include="Shared\Win32.fs" />
    <Compile Include="Shared\AppearanceModel.fs" />
    <Compile Include="Shared\ProgramTypes.fs" />
    <Compile Include="Shared\Localization.fs" />
    <Compile Include="Shared\SettingsCatalog.fs" />
    <Compile Include="Shared\DragDrop.fs" />
    <Compile Include="Shared\Serialize.fs" />
    <Compile Include="Shared\Win32Menu.fs" />
    <Compile Include="Shared\Services.fs" />
    <Compile Include="Shared\RuntimeDiagnostics.fs" />
    <Compile Include="Shared\Theme.fs" />
    <Compile Include="Shared\ThemePresets.fs" />
    <Compile Include="Shared\ThemeService.fs" />
    <Compile Include="Shared\AnimationWindow.fs" />
    <Compile Include="Shared\Forms.fs" />
    <Compile Include="Shared\Json.fs" />
    <Compile Include="Shared\Shell.fs" />
    <Compile Include="Shared\Model.fs" />
    <Compile Include="Shared\UIHelper.fs" />
    <Compile Include="HotKeyManager.fs" />
    <Compile Include="DragDropController.fs" />
    <Compile Include="TabStripSprite.fs" />
    <Compile Include="TabShadow.fs" />
    <Compile Include="TabStrip.fs" />
    <Compile Include="AppearanceJson.fs" />
    <Compile Include="SettingsFileStore.fs" />
    <Compile Include="Settings.fs" />
    <Compile Include="TaskSwitch.fs" />
    <Compile Include="WindowDecorator.fs" />
    <Compile Include="OleDropTarget.fs" />
    <Compile Include="WindowGroup.fs" />
    <Compile Include="TabStripDecorator.fs" />
    <Compile Include="GroupPlugins\SuperBarPlugin.fs" />
    <Compile Include="GroupPlugins\MouseScrollPlugin.fs" />
    <Compile Include="GroupPlugins\NumericTabHotKeyPlugin.fs" />
    <Compile Include="GroupPlugins\HideTabsOnInactiveGroupPlugin.fs" />
    <Compile Include="Desktop.fs" />
    <Compile Include="Workspace\WorkspaceData.fs" />
    <Compile Include="Workspace\WorkspaceModel.fs" />
    <Compile Include="Workspace\WorkspaceView.fs" />
    <Compile Include="ManagerViewService\ThemeBinding.fs" />
    <Compile Include="ManagerViewService\SettingsStyle.fs" />
    <Compile Include="ManagerViewService\SettingsControls.fs" />
    <Compile Include="ManagerViewService\SettingsEditors.fs" />
    <Compile Include="ManagerViewService\SettingsPage.fs" />
    <Compile Include="ManagerViewService\SettingsUi.fs" />
    <Compile Include="ManagerViewService\SettingsBindings.fs" />
    <Compile Include="ManagerViewService\Views\GeneralView.fs" />
    <Compile Include="ManagerViewService\Views\AppearanceView.fs" />
    <Compile Include="ManagerViewService\Views\BehaviorView.fs" />
    <Compile Include="ManagerViewService\Views\DiagnosticsView.fs" />
    <Compile Include="ManagerViewService\Views\ProgramView.fs" />
    <Compile Include="ManagerViewService\DesktopManagerForm.fs" />
    <Compile Include="ManagerViewService\ManagerViewService.fs" />
    <Compile Include="FilterService.fs" />
    <Compile Include="DesktopPlugins\InputManagerPlugin.fs" />
    <Compile Include="DesktopPlugins\NotifyIconPlugin.fs" />
    <Compile Include="DesktopPlugins\ExceptionHandlerPlugin.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Loaded by file name (GetManifestResourceStream "Bemo.ico"), so keep the bare names. -->
    <EmbeddedResource Include="Resources\*.ico;Resources\*.png" LogicalName="%(Filename)%(Extension)" />  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
    <!-- 13.0.2+ carries internal copies of System.Diagnostics.CodeAnalysis attributes that FSharp.Core 7+
         also carries, and F# static linking (Release) cannot merge the duplicates.
         13.0.1 already has the deep-nesting security fix. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Interop.SHDocVw" HintPath="..\Interop.SHDocVw.dll" />
    <Reference Include="Interop.Shell32" HintPath="..\Interop.Shell32.dll" />
    <ProjectReference Include="..\Win32\Win32.csproj" />
    <ProjectReference Include="..\treeviewadv\Aga.Controls\Aga.Controls.csproj" />
  </ItemGroup>

</Project>
