<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Aga.Controls</RootNamespace>
    <AssemblyName>Aga.Controls</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Upstream sources that were never part of this build. -->
    <Compile Remove="Tree\ColumnCollection.cs;Tree\NativeMethods.cs" />
    <!-- Plain embedded files rather than a .resx with bitmaps: .NET Core MSBuild
         (dotnet build) cannot compile non-string .resx data for .NET Framework. -->
    <EmbeddedResource Include="Resources\*" Exclude="Resources\Thumbs.db" LogicalName="Aga.Controls.Resources.%(Filename)%(Extension)" />
    <None Remove="Resources\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
